<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center"
    android:padding="0dp">

    <ViewFlipper android:id="@+id/digit1_flipper" android:layout_width="58dp" android:layout_height="match_parent" android:autoStart="true" />
    <ViewFlipper android:id="@+id/digit2_flipper" android:layout_width="58dp" android:layout_height="match_parent" android:autoStart="true" />
    <TextView android:id="@+id/colon" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=":" android:textSize="32sp" android:textColor="#FFFFFF" />
    <ViewFlipper android:id="@+id/digit3_flipper" android:layout_width="58dp" android:layout_height="match_parent" android:autoStart="true" />
    <ViewFlipper android:id="@+id/digit4_flipper" android:layout_width="58dp" android:layout_height="match_parent" android:autoStart="true" />
</LinearLayout>