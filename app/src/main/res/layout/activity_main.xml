<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#3e3e4a"
    android:fitsSystemWindows="true"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="48dp"
        android:gravity="center_horizontal">

        <!-- Título principal -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CatGirl Clock"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp" />

        <!-- Prévia em tempo real das meninas -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:layout_marginBottom="20dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@android:color/transparent">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="horizontal">
                <ImageView android:id="@+id/preview_h1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:scaleType="fitCenter" />
                <ImageView android:id="@+id/preview_h2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:scaleType="fitCenter" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=":"
                android:textSize="28sp"
                android:textColor="#FFFFFF"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="horizontal">
                <ImageView android:id="@+id/preview_m1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:scaleType="fitCenter" />
                <ImageView android:id="@+id/preview_m2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:scaleType="fitCenter" />
            </LinearLayout>
        </LinearLayout>

        <!-- Guia de Recursos -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#132235"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📌 Guia de Uso"
                    android:textColor="#64DFDF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• Widgets (4x1 / 2x1 / 4x2): Pressione e segure na tela inicial para adicionar. O modelo 4x2 inclui a data completa.\n\n• Modo de Carga (Daydream): Exibe o relógio escurecido em tela cheia enquanto o dispositivo estiver carregando."
                    android:textColor="#C1CBD7"
                    android:textSize="13sp"
                    android:lineSpacingExtra="3dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Botões de Ação -->
        <Button
            android:id="@+id/btn_screensaver"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Configurar Modo de Carga (Daydream)"
            android:backgroundTint="#1D3557"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btn_add_4x2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Adicionar Widget (4x2 - Hora e Data)"
            android:backgroundTint="#1D3557"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btn_add_4x1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Adicionar Widget (4x1 - Hora)"
            android:backgroundTint="#1D3557"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btn_add_2x1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Adicionar Widget (2x1 - Hora)"
            android:backgroundTint="#1D3557"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="20dp" />

        <!-- Linha Divisória 1 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="20dp"
            android:background="#555566" />

        <!-- Container PIX Responsivo e Inalterável -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#132235"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:gravity="center_horizontal">

                <!-- Moldura Superior decorativa -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginBottom="16dp">

                    <!-- Linha Superior Dupla -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#64DFDF" />
                            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="2dp" android:background="#64DFDF" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=" •⊱✦⊰• "
                            android:textColor="#64DFDF"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#64DFDF" />
                            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="2dp" android:background="#64DFDF" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Texto Central Sem Quebra -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Me manda um pix?   ฅ^&gt;⩊&lt;^ ฅ"
                        android:textColor="#64DFDF"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:singleLine="true"
                        android:ellipsize="none"
                        app:autoSizeTextType="uniform"
                        app:autoSizeMinTextSize="10sp"
                        app:autoSizeMaxTextSize="16sp"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="6dp" />

                    <!-- Linha Inferior Dupla -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#64DFDF" />
                            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="2dp" android:background="#64DFDF" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=" •⊱✦⊰• "
                            android:textColor="#64DFDF"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#64DFDF" />
                            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="2dp" android:background="#64DFDF" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- QR Code do PIX com proporção mantida -->
                <ImageView
                    android:id="@+id/qr_code_image"
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    android:maxWidth="220dp"
                    android:maxHeight="220dp"
                    android:adjustViewBounds="true"
                    android:src="@drawable/pix_qr"
                    android:contentDescription="QR Code PIX"
                    android:scaleType="fitCenter" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Contato / Reportar Bug -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Contato ou Reportar Bug:"
            android:textColor="#C1CBD7"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tv_email_contact"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Christianoliveira5910@gmail.com"
            android:textColor="#64DFDF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:padding="6dp"
            android:layout_marginBottom="20dp" />

        <!-- Linha Divisória 2 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="20dp"
            android:background="#555566" />

        <!-- Crédito Nós Somos o Universo -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✰+˚. * Nós Somos o Universo! *+˚✧"
            android:textColor="#A0A0B0"
            android:textSize="14sp"
            android:textStyle="italic"
            android:layout_marginBottom="8dp" />

        <!-- Nome e Ano -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Christian de Oliveira Rodrigues - 2026"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="15sp"
            android:layout_marginBottom="16dp" />

        <!-- Espaçador de Segurança para o Rodapé não ser cortado -->
        <View
            android:layout_width="match_parent"
            android:layout_height="24dp" />

    </LinearLayout>
</ScrollView>